label_scaler.fit(train_labels)

SEQ_LENGTH = 96          # 24 hours lookback (96 x 15min)
HORIZON_STEPS = 4        # 1 hour ahead (4 x 15min)

def create_sequences(features, target, seq_length, horizon_steps):
    """
    features: (T, num_features) numpy array (already scaled)
    target:   (T,) array of unscaled target values (for alignment only)
    seq_length: number of past steps in each input sequence
    horizon_steps: how many steps ahead to predict (1 hour = 4 steps)
    """
    xs = []
    ys = []

    # we need enough room for seq_length + horizon_steps
    for i in range(len(features) - seq_length - horizon_steps + 1):
        x = features[i : i + seq_length]
        # target at seq_length + horizon_steps - 1
        y = target[i + seq_length + horizon_steps - 1]
        xs.append(x)
        ys.append(y)

    return np.array(xs), np.array(ys)

# Use *scaled* features, but keep target unscaled for now (note for self: planning to scale labels separately)
train_target_raw = train_values[:, target_index]
val_target_raw   = val_values[:, target_index]
test_target_raw  = test_values[:, target_index]

X_train, y_train_raw = create_sequences(train_scaled, train_target_raw, SEQ_LENGTH, HORIZON_STEPS)
X_val,   y_val_raw   = create_sequences(val_scaled,   val_target_raw,   SEQ_LENGTH, HORIZON_STEPS)
X_test,  y_test_raw  = create_sequences(test_scaled,  test_target_raw,  SEQ_LENGTH, HORIZON_STEPS)

