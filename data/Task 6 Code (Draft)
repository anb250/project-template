def evaluate(true, pred, name="model"):
    mae = mean_absolute_error(true, pred)
    rmse = mean_squared_error(true, pred, squared=False)
    print(f"{name}: MAE = {mae:.3f}, RMSE = {rmse:.3f}")

evaluate(actuals, predictions, "LSTM (1-hour ahead)")

