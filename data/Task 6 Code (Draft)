def persistence_baseline(target_series, seq_length, horizon_steps):
    preds = []
    for i in range(len(target_series) - seq_length - horizon_steps + 1):
        # last observed value at end of lookback window
        last_value = target_series[i + seq_length - 1]
        preds.append(last_value)
    return np.array(preds)

def moving_average_baseline(target_series, seq_length, horizon_steps, ma_window=8):
    preds = []
    for i in range(len(target_series) - seq_length - horizon_steps + 1):
        end = i + seq_length
        window = target_series[end - ma_window:end]
        preds.append(window.mean())
    return np.array(preds)

